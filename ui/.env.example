BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Port the dev server binds. Leave unset for Next's default (3000, auto-
# incrementing if busy). scripts/worktree-sync-env.sh sets this per git worktree
# and points the backend's CORS_ALLOWED_ORIGINS + UI_APP_URL at it.
# UI_PORT=3000
# Base URL of the user-facing app, used for superadmin impersonation redirects
# (defaults to the current origin when unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_NODE_ENV=development
# form submissions backend
# NEXT_PUBLIC_ONBOARDING_API_URL=http://localhost:8001
# Google Tag Manager container ID (e.g. GTM-XXXXXXX); GTM is not loaded when blank
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook) Pixel ID; the Pixel is not loaded when blank (OSS/dev)
NEXT_PUBLIC_META_PIXEL_ID=
# Landing page "Call me" live demo (server-only). Trigger UUID of the demo agent's
# API trigger and an org API key that owns it; the form is hidden when either is blank.
DEMO_CALL_AGENT_UUID=
DEMO_CALL_API_KEY=
# Comma-separated E.164 prefixes the live demo is allowed to dial (default +972)
# DEMO_CALL_ALLOWED_PREFIXES=+972
# Public origin of the marketing site, used for canonical/OG/sitemap URLs (default https://callsawt.com)
# NEXT_PUBLIC_SITE_URL=https://callsawt.com
