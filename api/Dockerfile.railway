# syntax=docker/dockerfile:1
# Railway-compatible Dockerfile (api/Dockerfile.railway)
#
# Differences from api/Dockerfile:
# 1. No --mount=type=bind  — Metal builder only allows --mount=type=cache with id=
# 2. No --mount=type=cache — Metal builder requires id= on each; dropped for portability
# 3. No ts-deps stage      — Railway build context excludes api/mcp_server/ts_validator
#                            in non-runner stages; npm ci runs in runner after COPY ./api
# 4. No COPY docs/         — excluded from Railway snapshot (like scripts/)
# 5. No COPY scripts/      — excluded from Railway snapshot; start logic lives in railway.json

# ── Stage 1: Python venv ──────────────────────────────────────────────────────
FROM python:3.13-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN python -m venv "$VIRTUAL_ENV"

# API deps
COPY api/requirements.txt /tmp/req.txt
RUN uv pip install -r /tmp/req.txt

# Pipecat deps — install directly from the dograh fork on GitHub so we don't
# need the git submodule in the build context (Railway doesn't clone submodules).
RUN uv pip install \
    'pipecat-ai[cartesia,deepgram,openai,elevenlabs,groq,google,azure,sarvam,soundfile,silero,webrtc,speechmatics,openrouter,camb,mcp] @ git+https://github.com/dograh-hq/pipecat.git@b0ac013a08cf74131a93afc5213af6b4802e5871' \
 && uv pip uninstall opencv-python \
 && uv pip install opencv-python-headless \
 && python -c "import nltk; nltk.download('punkt_tab', download_dir='/opt/venv/nltk_data', quiet=True)"

# Strip .pyc / tests / type stubs
RUN find /opt/venv -type f -name '*.pyc' -delete && \
    find /opt/venv -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /opt/venv -type f -name '*.pyo' -delete && \
    find /opt/venv -type d \( -name tests -o -name test -o -name examples \) -prune -exec rm -rf {} + && \
    find /opt/venv -name '*.pyi' -delete

# ── Stage 2: Static ffmpeg ────────────────────────────────────────────────────
FROM debian:trixie-slim AS ffmpeg-static
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils \
    && curl -fsSL -o /tmp/ffmpeg.tar.xz "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-${TARGETARCH}-static.tar.xz" \
    && mkdir -p /tmp/ffmpeg \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1 \
    && mv /tmp/ffmpeg/ffmpeg /tmp/ffmpeg/ffprobe /usr/local/bin/ \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# ── Stage 3: Runtime ──────────────────────────────────────────────────────────
FROM python:3.13-slim AS runner

WORKDIR /app

RUN groupadd --system dograh \
 && useradd --system --gid dograh --no-log-init --home-dir /app --shell /usr/sbin/nologin dograh \
 && chown dograh:dograh /app

COPY --from=ffmpeg-static /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg-static /usr/local/bin/ffprobe /usr/local/bin/ffprobe

# node + npm for ts_validator (MCP TypeScript bridge)
COPY --from=node:22-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-slim /usr/local/bin/npm /usr/local/bin/npm
COPY --from=node:22-slim /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

COPY --from=builder /opt/venv /opt/venv

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LOG_TO_FILE=false

# Copy application code — includes api/mcp_server/ts_validator
COPY --chown=dograh:dograh ./api ./api

# Install ts_validator node_modules (run as root before USER dograh)
RUN cd /app/api/mcp_server/ts_validator \
 && npm ci --omit=dev \
 && npm cache clean --force \
 && chown -R dograh:dograh /app/api/mcp_server/ts_validator/node_modules

USER dograh

# PORT injected by Railway; startCommand in railway.json runs migrations then uvicorn
EXPOSE 8000
